NODE_ENV=production
PORT=9000

# Printer model selection: "xp-380" or "xp-80t"
PRINTER_MODEL=xp-80t

# Manual VID/PID override (hex, no 0x prefix) — takes priority over PRINTER_MODEL.
# Read these off Zadig's device list (shown as VVVV:PPPP) after installing WinUSB.
# PRINTER_VID=1FC9
# PRINTER_PID=2016
